# NaviRAG 后端环境变量配置
# 复制此文件为 .env 并填入实际值

# 数据库
DATABASE_URL=postgresql+asyncpg://navirag:navirag@localhost:5432/navirag

# LLM API（硅基流动 / OpenAI 兼容接口）
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1

# 应用
DEBUG=false
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
